GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Explicit development/testing only. Live mode never falls back to mock.
USE_MOCK=false
LOW_CONFIDENCE_THRESHOLD=0.70
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional tiled callout detection for large drawings (BOM is never tiled).
CALLOUT_TILING_ENABLED=false
# Grid size: 2x2 (default) or 3x3
CALLOUT_TILE_GRID=2x2
# Overlap as fraction of each cell (0.10–0.15 recommended)
CALLOUT_TILE_OVERLAP=0.12
# IoU threshold for same-bubble dedupe across tiles
CALLOUT_DEDUPE_IOU=0.5

# Optional second-pass crop verification of each detected callout
CALLOUT_VERIFICATION_ENABLED=false
