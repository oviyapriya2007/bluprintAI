# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env
.env.*
!.env.example

# Pytest / tooling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Document-processor runtime outputs (never commit generated images)
document-processor/processed/**
!document-processor/processed/.gitkeep
document-processor/samples/**
!document-processor/samples/.gitkeep

# Top-level pipeline demo output (regenerate with run_pipeline.py)
/pipeline_output/

# Temporary live-vision diagnostics dumps (see vision_extractor.diagnostics)
/debug-output/

# OS / editor junk
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
.idea/
.vscode/
